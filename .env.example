# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real credentials.

# ─── Nextcloud ────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=change_me_strong_password
NEXTCLOUD_ADMIN_USER=your_admin_user
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# Path on the host where Nextcloud will store user data.
# Must be on a large disk — avoid the OS disk.
NEXTCLOUD_DATA_PATH=/mnt/yourdisk/nextcloud/data

# ─── Jellyfin ─────────────────────────────────────────────────
# Path to your media library (movies, shows, music).
MEDIA_PATH=/mnt/yourdisk/Media

# ─── Syncthing ────────────────────────────────────────────────
# Path that Syncthing will sync with remote devices.
SYNC_DATA_PATH=/mnt/yourdisk/sync

# ─── n8n ──────────────────────────────────────────────────────
# Extra storage volume mounted as /Storage1 inside the container.
STORAGE_PATH=/mnt/yourdisk/storage

# ─── qBittorrent ──────────────────────────────────────────────
# Directory where downloaded files will land.
DOWNLOADS_PATH=/mnt/yourdisk/Downloads

# ─── PoupaMercado (poupa-db) ────────────────────────────────
# Password for the dedicated Postgres container (cupons fiscais catalog).
POUPA_DB_PASSWORD=change_me_strong_password
